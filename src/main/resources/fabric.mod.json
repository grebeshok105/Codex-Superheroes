{
	"schemaVersion": 1,
	"id": "superheroes",
	"version": "${version}",
	"name": "Codex Superheroes",
	"description": "A Fabric superhero mod with transformations, signature abilities, flight, HUD, custom models and VFX.",
	"authors": [
		"grebeshok105"
	],
	"contact": {
		"homepage": "https://github.com/grebeshok105/Codex-Superheroes",
		"sources": "https://github.com/grebeshok105/Codex-Superheroes"
	},
	"license": "CC0-1.0",
	"icon": "assets/superheroes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.superheroes.SuperheroesMod"
		],
		"client": [
			"com.example.superheroes.client.SuperheroesClient"
		],
		"fabric-datagen": [
			"com.example.superheroes.datagen.SuperheroesDataGenerator"
		]
	},
	"mixins": [
		"superheroes.mixins.json",
		{
			"config": "superheroes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": ">=0.116.12",
		"geckolib": ">=4.5.0"
	},
	"recommends": {
		"veil": ">=4.1.2"
	}
}