        "var.segment_5": "clamp((var.takeoff_t-0.24)/0.03500000000000003,0,1)",
        "var.segment_6": "clamp((var.takeoff_t-0.275)/0.034999999999999976,0,1)",
        "var.segment_7": "clamp((var.takeoff_t-0.31)/0.06,0,1)",
        "var.segment_8": "clamp((var.takeoff_t-0.37)/0.08000000000000002,0,1)",
        "var.segment_9": "clamp((var.takeoff_t-0.45)/0.11000000000000004,0,1)",
