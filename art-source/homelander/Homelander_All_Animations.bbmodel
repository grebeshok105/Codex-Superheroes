  "emf_lab": {
    "target": "Minecraft 1.21.1 Fabric / EMF 3.3.9",
    "runtime_verified": false,
    "preview_only": true,
    "hover_seconds": 3.2,
    "takeoff_seconds": 0.8,
    "animations": [
      {
        "var.phase": "var.hover_time / 3.2",
        "var.breath": "keyframeloop(var.phase * 8, 0, 0.06, 0.16, 0.18, 0.10, -0.06, -0.13, -0.08)",
        "var.balance": "keyframeloop(var.phase * 8 + 0.7, 0, 0.12, 0.24, 0.10, -0.15, -0.22, -0.14, -0.04)",
        "var.pitch": "keyframeloop(var.phase * 8 + 0.2, 0, 0.24, 0.42, 0.31, 0.03, -0.25, -0.32, -0.18)",
        "var.yaw": "0.30 * keyframeloop(var.phase * 8 + 1.1, 0, 0.20, 0.32, 0.15, -0.13, -0.29, -0.19, -0.08) + 0.045 * sin(4 * pi * var.phase + 0.6)",
        "var.shoulder": "keyframeloop(var.phase * 8 - 0.38, 0, 0.06, 0.16, 0.18, 0.10, -0.06, -0.13, -0.08)",
        "var.leg_follow": "keyframeloop(var.phase * 8 - 0.9, 0, 0.12, 0.24, 0.10, -0.15, -0.22, -0.14, -0.04)",
        "root.rx": "torad(0.10 * var.pitch)",
        "root.ry": "torad(0)",
        "root.rz": "torad(-0.6 + 0.35 * var.balance)",
        "body.rx": "torad(1.8 + var.pitch)",
        "body.ry": "torad(-1.4 + var.yaw)",
        "body.rz": "torad(1.1 + 0.70 * var.balance)",
        "head.rx": "torad(-1.7 - 0.88 * var.pitch)",
        "head.ry": "torad(3 - 0.72 * var.yaw)",
        "head.rz": "torad(-0.8 - 0.84 * var.balance)",
        "right_arm.rx": "torad(-3 + 3.0 * var.shoulder - 0.32 * var.pitch)",
        "right_arm.ry": "torad(-4 - 0.20 * var.yaw)",
        "right_arm.rz": "torad(-4.5 - 0.65 * var.balance - 1.20 * var.shoulder)",
        "left_arm.rx": "torad(-1 + 2.35 * var.shoulder - 0.24 * var.pitch)",
        "left_arm.ry": "torad(3 - 0.16 * var.yaw)",
        "left_arm.rz": "torad(5.5 - 0.42 * var.balance + 0.90 * var.shoulder)",
        "right_forearm.rx": "torad(11 - 1.15 * var.shoulder + 0.18 * var.leg_follow)",
        "right_forearm.ry": "torad(0)",
        "right_forearm.rz": "torad(-0.7)",
        "left_forearm.rx": "torad(8 - 0.85 * var.shoulder - 0.12 * var.leg_follow)",
        "left_forearm.ry": "torad(0)",
        "left_forearm.rz": "torad(0.7)",
        "right_leg.rx": "torad(20 + 0.62 * var.leg_follow + 0.34 * var.pitch)",
        "right_leg.ry": "torad(-5 - 0.18 * var.yaw)",
        "right_leg.rz": "torad(-3 - 0.40 * var.balance)",
        "right_shin.rx": "torad(-27 - 0.48 * var.leg_follow - 0.22 * var.pitch)",
        "right_shin.ry": "torad(0)",
        "right_shin.rz": "torad(0)",
        "right_foot.rx": "torad(6 - 0.18 * var.leg_follow)",
        "right_foot.ry": "torad(0)",
        "right_foot.rz": "torad(0)",
        "left_leg.rx": "torad(-4 - 0.34 * var.leg_follow + 0.19 * var.pitch)",
        "left_leg.ry": "torad(3 + 0.15 * var.yaw)",
        "left_leg.rz": "torad(2 - 0.25 * var.balance)",
        "left_shin.rx": "torad(-6 + 0.28 * var.leg_follow - 0.12 * var.pitch)",
        "left_shin.ry": "torad(0)",
        "left_shin.rz": "torad(0)",
        "left_foot.rx": "torad(3 + 0.12 * var.leg_follow)",
        "left_foot.ry": "torad(0)",
        "left_foot.rz": "torad(0)",
        "right_knee.rx": "right_shin.rx * 0.5",
        "right_knee.ry": "0",
        "right_knee.rz": "0",
        "left_knee.rx": "left_shin.rx * 0.5",
        "left_knee.ry": "0",
        "left_knee.rz": "0",
        "root.tx": "0.13 * var.balance",
        "root.ty": "6.6 + var.breath",
        "root.tz": "0.05 * var.leg_follow",
        "right_arm.ty": "0.23 * var.shoulder",
        "left_arm.ty": "0.17 * var.shoulder"
      }
    ],
    "takeoff_animations": [
      {
        "var.takeoff_t": "clamp(var.takeoff_time,0,0.8)",
        "var.segment_0": "clamp((var.takeoff_t-0)/0.06,0,1)",
        "var.segment_1": "clamp((var.takeoff_t-0.06)/0.06,0,1)",
        "var.segment_2": "clamp((var.takeoff_t-0.12)/0.06,0,1)",
        "var.segment_3": "clamp((var.takeoff_t-0.18)/0.024999999999999994,0,1)",
